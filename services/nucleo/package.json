{
  "name": "nucleo",
  "version": "0.0.0",
  "private": true,
  "description": "Núcleo de Brecha: NestJS hexagonal con DDD, REST, MCP y Prisma.",
  "scripts": {
    "generar": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint . && depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrar": "prisma migrate deploy",
    "test:cobertura": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/swagger": "12.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@brecha/config": "workspace:*",
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.6.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.9.0",
    "eslint": "10.15.0",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "@vitest/coverage-v8": "5.1.1"
  }
}

{
  "name": "nucleo",
  "version": "0.0.0",
  "private": true,
  "description": "Núcleo de Brecha: NestJS hexagonal con DDD, REST, MCP y Prisma.",
  "scripts": {
    "generar": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint . && depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrar": "prisma migrate deploy",
    "test:cobertura": "vitest run --coverage",
    "contrato:exportar": "tsc -p tsconfig.build.json && node dist/contrato.js && pnpm --filter @brecha/contratos tipos",
    "clave": "tsc -p tsconfig.build.json && node dist/acceso/cli-clave.js",
    "importar": "tsc -p tsconfig.build.json && node dist/postulaciones/infraestructura/importacion/cli-importar.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/swagger": "12.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "express": "5.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@brecha/config": "workspace:*",
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.6.0",
    "@swc/core": "1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.1.1",
    "dependency-cruiser": "18.9.0",
    "eslint": "10.15.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.1"
  }
}

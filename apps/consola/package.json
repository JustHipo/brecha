{
  "name": "consola",
  "version": "0.0.0",
  "private": true,
  "description": "Consola de Brecha: Angular 22 con Spartan sobre Tailwind 4.",
  "scripts": {
    "dev": "ng serve --proxy-config proxy.conf.cjs",
    "build": "ng build",
    "test": "ng test --watch=false",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint . && node scripts/claves-iguales.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@jsverse/transloco": "8.4.0",
    "@ng-icons/core": "33.4.0",
    "@ng-icons/lucide": "33.4.0",
    "@spartan-ng/brain": "1.10.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "luxon": "3.7.2",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@axe-core/playwright": "4.14.0",
    "@brecha/config": "workspace:*",
    "@brecha/contratos": "workspace:*",
    "@playwright/test": "1.65.1",
    "@spartan-ng/cli": "1.10.0",
    "@tailwindcss/postcss": "4.3.5",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "pg": "8.23.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}

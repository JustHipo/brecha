{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generar"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build", "generar"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generar"]
    },
    "test": {
      "dependsOn": ["^build", "generar"],
      "env": ["DATABASE_URL", "DATABASE_URL_PRUEBAS"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generar": {
      "outputs": ["src/generado/**"]
    },
    "contrato:exportar": {
      "dependsOn": ["generar"],
      "cache": false
    }
  }
}

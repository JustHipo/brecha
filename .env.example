# Copia este archivo a .env y ajusta. El .env nunca va al repo.

# PostgreSQL del docker compose (solo en 127.0.0.1)
POSTGRES_PASSWORD=brecha_local
NUCLEO_DB_PASSWORD=nucleo_local
IA_DB_PASSWORD=ia_local
DATABASE_URL=postgresql://nucleo:nucleo_local@127.0.0.1:5433/brecha?schema=nucleo
# Base desechable para las pruebas de integración
DATABASE_URL_PRUEBAS=postgresql://nucleo:nucleo_local@127.0.0.1:5433/brecha_pruebas?schema=nucleo

# Núcleo
NUCLEO_PUERTO=4300
# Origen permitido de la consola (ADR 0019)
CONSOLA_ORIGEN=http://localhost:4200
# Carpeta de la instancia (tokens y configuración local)
BRECHA_DIR=./.brecha
